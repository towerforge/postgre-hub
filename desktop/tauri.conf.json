{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Postgre Hub",
  "version": "../frontend/package.json",
  "identifier": "com.towerforge.postgrehub",
  "build": {
    "frontendDist": "placeholder"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; style-src 'unsafe-inline'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "category": "DeveloperTool",
    "shortDescription": "PostgreSQL database manager",
    "longDescription": "Postgre Hub: manage PostgreSQL connections, browse schemas, run SQL and export data from a native window.",
    "publisher": "Towerforge",
    "homepage": "https://github.com/towerforge/postgre-hub",
    "license": "MIT",
    "copyright": "Towerforge",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "deb": { "depends": [] },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
